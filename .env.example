# SMTP used to email new website enquiries (contact form + chatbot) to the Ideate X inbox
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: defaults to "Ideate X Website" <SMTP_USER>
SMTP_FROM=
# Optional: defaults to hello@ideatex.co.in
ENQUIRY_TO_EMAIL=hello@ideatex.co.in
